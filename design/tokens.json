  "spacing": {
    "page-x": 16,
    "page-y": 40,
    "page-y-wide": 64,
    "card": 24,
    "card-wide": 40,
    "logo": 40,
    "header-gap": 24,
    "title-gap": 8,
    "form-gap": 32,
    "field-gap": 20,
    "label-gap": 6,
    "control": 44,
    "control-x": 12,
    "check": 20,
    "check-gap": 12,
    "ring": 3,
    "icon": 48
  },
  "container": {
    "card": 448
  },
  "breakpoint": {
    "sm": 640
  }
