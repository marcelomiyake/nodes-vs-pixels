{
  "font": {
    "family": "Inter",
    "fallback": "ui-sans-serif, system-ui, sans-serif",
    "file": "inter-latin.woff2",
    "weightRange": "400 600"
  },
  "color": {
    "page": "#f1f5f9",
    "surface": "#ffffff",
    "line": "#e2e8f0",
    "field": "#cbd5e1",
    "ink": "#0f172a",
    "label": "#334155",
    "muted": "#475569",
    "subtle": "#64748b",
    "brand": "#4f46e5",
    "brand-strong": "#4338ca",
    "on-brand": "#ffffff",
    "brand-ring": "rgba(79, 70, 229, 0.25)",
    "danger": "#dc2626",
    "danger-ring": "rgba(220, 38, 38, 0.25)",
    "danger-soft": "#fef2f2",
    "success": "#059669",
    "success-soft": "#d1fae5"
  },
  "text": {
    "title": { "size": 24, "lineHeight": 32, "weight": 600 },
    "body": { "size": 16, "lineHeight": 24, "weight": 400 },
    "button": { "size": 16, "lineHeight": 24, "weight": 600 },
    "label": { "size": 14, "lineHeight": 20, "weight": 500 },
    "small": { "size": 14, "lineHeight": 20, "weight": 400 },
    "logo": { "size": 15, "lineHeight": 20, "weight": 600 }
