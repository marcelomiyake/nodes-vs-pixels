# Shared by both frontend images. ${BACKEND_URL} is filled in at container start.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types text/css text/plain application/javascript application/json application/wasm image/svg+xml;

    # add_header inside a location replaces the inherited ones, so locations repeat it.
    add_header X-Content-Type-Options nosniff always;

    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }

    # Only Vite's content-hashed output is immutable; everything else (including the
    # fixed-name WebAssembly bundle and font) is revalidated on every load.
    location /assets/ {
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /signup.v1.SignupService/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
